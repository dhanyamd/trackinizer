{
  "name": "trackinizer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "codegen": "node scripts/codegen.ts",
    "dev": "node scripts/codegen.ts && vite --host 127.0.0.1",
    "build": "node scripts/codegen.ts && node scripts/design-brief.ts && vite build",
    "test": "node scripts/codegen.ts && vitest run",
    "test:manual": "node scripts/codegen.ts && TRACKINIZER_WEB_MANUAL_TESTS=1 vitest run --tags-filter manual",
    "typecheck": "node scripts/codegen.ts && tsc --noEmit",
    "e2e": "node scripts/codegen.ts && vite build --outDir dist-e2e/${TRACKINIZER_E2E_PORT:-8797} --emptyOutDir --logLevel warn && playwright test",
    "size": "node scripts/bundle-size.ts",
    "screenshots": "node scripts/codegen.ts && vite build --outDir dist-screenshots --emptyOutDir --logLevel warn && node scripts/screenshots.ts",
    "demo-video": "node scripts/codegen.ts && vite build --outDir dist-screenshots --emptyOutDir --logLevel warn && node scripts/demo_video.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@types/three": "^0.186.0",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "force-graph": "1.51.4",
    "html-to-image": "1.11.13",
    "katex": "^0.19.1",
    "lowlight": "3.3.0",
    "markmap-lib": "^0.18.13",
    "mdast-util-find-and-replace": "3.0.2",
    "mermaid": "^12.3.0",
    "openapi-fetch": "^0.17.0",
    "plotly.js": "^4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "three": "^0.186.1",
    "tinykeys": "4.0.1",
    "uplot": "^1.6.32",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
